{
    "name": "@microsoft/applicationinsights-react-native",
    "version": "4.4.0",
    "description": "Microsoft Application Insights React Native Plugin",
    "main": "dist-esm/index.js",
    "types": "types/index.d.ts",
    "sideEffects": false,
    "author": "Microsoft Application Insights Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/microsoft/applicationinsights-react-native"
    },
    "bugs": {
        "url": "https://github.com/microsoft/applicationinsights-react-native/issues"
    },
    "homepage": "https://github.com/microsoft/applicationinsights-react-native#readme",
    "keywords": [
        "performance monitoring",
        "application insights",
        "microsoft",
        "azure",
        "react native"
    ],
    "scripts": {
        "build": "npm run build:deps && npm run build:esm && npm run build:package && npm run dtsgen",
        "build:deps": "grunt tst-framework && grunt rollupuglify && cd tools/rollup-plugin-uglify3-js && npx rollup -c && cd ../.. && cd common/Tests/Framework && npx rollup -c rollup.config.js && cd ../../..",
        "build:esm": "grunt reactnative",
        "build:package": "cd applicationinsights-react-native && npx rollup -c",
        "rebuild": "npm run build",
        "test": "grunt reactnativetests",
        "mintest": "grunt reactnative-mintests",
        "lint": "cd applicationinsights-react-native && npm run lint",
        "dtsgen": "cd applicationinsights-react-native && npm run dtsgen",
        "serve": "grunt serve",
        "setVersion": "node ./tools/release-tools/setVersion.js",
        "setAiVersion": "node ./tools/release-tools/setAiVersion.js",
        "fullClean": "git clean -xdf && npm install",
        "fullCleanBuild": "npm run fullClean && npm run rebuild",
        "ai-min": "grunt reactnative-min",
        "ai-restore": "grunt reactnative-restore",
        "gh-status": "node ./tools/status-tools/github-status.js",
        "npm-package": "node ./tools/release-tools/npm-package.js"
    },
    "devDependencies": {
        "@nevware21/grunt-eslint-ts": "^0.5.2",
        "@nevware21/grunt-ts-plugin": "^0.5.2",
        "@typescript-eslint/eslint-plugin": "^7.14.1",
        "@typescript-eslint/parser": "^7.14.1",
        "archiver": "^5.3.0",
        "connect": "^3.7.0",
        "eslint": "^8.56.0",
        "eslint-plugin-security": "^1.5.0",
        "grunt": "^1.6.2",
        "grunt-cli": "^1.5.0",
        "grunt-contrib-connect": "^3.0.0",
        "grunt-contrib-uglify": "^5.0.1",
        "grunt-string-replace": "^1.3.1",
        "eventemitter2": "6.4.9",
        "puppeteer": "^24.40.0",
        "react-native-device-info": ">=5.2.1",
        "typedoc": "^0.22.8",
        "typescript": "^4.3.4",
        "whatwg-fetch": "^3.0.0",
        "@types/node": "^18.0.0"
    },
    "dependencies": {
        "@microsoft/applicationinsights-core-js": "^3.4.1",
        "@microsoft/applicationinsights-shims": "^3.0.1",
        "@microsoft/dynamicproto-js": "^2.0.3",
        "@nevware21/ts-utils": ">= 0.11.3 < 2.x"
    },
    "overrides": {
        "basic-ftp": ">=5.2.0",
        "form-data": "^2.5.5",
        "tar": "^7.5.13",
        "minimatch": "^3.1.4",
        "lodash": "^4.18.1"
    },
    "peerDependencies": {
        "react-native": "*",
        "react-native-device-info": ">=5.2.1",
        "tslib": "*"
    },
    "peerDependenciesMeta": {
        "react-native-device-info": {
            "optional": true
        }
    },
    "workspaces": [
        "common/Tests/Framework",
        "tools/rollup-plugin-uglify3-js",
        "tools/release-tools",
        "applicationinsights-react-native"
    ]
}
